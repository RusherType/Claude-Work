# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (local: run `supabase start` and copy the values it prints)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only, never in client code

# AI
ANTHROPIC_API_KEY=                   # from console.anthropic.com (separate from your Claude Code login)
VOYAGE_API_KEY=

# Jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Shopify (Partners dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email and observability
RESEND_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
